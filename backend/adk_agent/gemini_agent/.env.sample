# ─────────────────────────────────────────────────────────────
# Gemini / Google 認證設定
# ─────────────────────────────────────────────────────────────
# 有兩種路徑可以二擇一：
#
# (A) Google AI Studio API Key（最簡單，免 GCP 帳單，適合本機測試）
#     申請：https://aistudio.google.com/app/apikey
#     GOOGLE_GENAI_USE_VERTEXAI=0
#     GOOGLE_API_KEY=ya29...你的金鑰...
#
# (B) Vertex AI（正式部署 / Cloud Run 推薦，需要 GCP 專案 + ADC）
#     GOOGLE_GENAI_USE_VERTEXAI=1
#     GOOGLE_CLOUD_PROJECT=your-project-id
#     GOOGLE_CLOUD_LOCATION=us-central1
#     另外需先執行 `gcloud auth application-default login`
#
# 預設提供 (A) 模板，請把 GOOGLE_API_KEY 換成你自己的金鑰再存檔。
# ─────────────────────────────────────────────────────────────

GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=<paste-your-google-ai-studio-api-key-here>

# 若改用 Vertex AI，把上面兩行註解、打開下面三行：
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=<your-google-cloud-project-id>
# GOOGLE_CLOUD_LOCATION=us-central1

# 使用的 Gemini 模型
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────
# 可選：動態翻譯（/api/i18n/translate）
# ─────────────────────────────────────────────────────────────
# 0 = 關閉 AI 翻譯（回傳原文，僅做快取流程）
# 1 = 啟用 Gemini 翻譯（需上方 GOOGLE_API_KEY 或 Vertex 設定可用）
EXHIBEAT_ENABLE_AI_TRANSLATION=0

# ─────────────────────────────────────────────────────────────
# 可選：外部資料來源
# ─────────────────────────────────────────────────────────────
# TDX 交通資料（用於附近捷運/公車查詢）
#   申請：https://tdx.transportdata.tw/
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Places API（用於場館評分、評論補強）
#   申請：https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
