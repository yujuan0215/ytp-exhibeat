# Gemini 認證設定
#
# 本專案本機開發統一使用 Google AI Studio API key。
# 申請：https://aistudio.google.com/app/apikey
#
# 不需要 Vertex AI，不需要 service account 憑證檔。

GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=<paste-your-google-ai-studio-api-key-here>

# 使用的 Gemini 模型
GEMINI_MODEL=gemini-2.5-flash

# 可選：外部資料來源

# TDX 交通資料，用於附近捷運/公車查詢。
# 申請：https://tdx.transportdata.tw/
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Places API (New)，用於場館評分、評論補強。
# 啟用：https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_MAPS_API_KEY=
