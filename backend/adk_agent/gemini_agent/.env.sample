# Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<your-google-cloud-project-id>
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash

# TDX Transport Data (optional, for nearby metro / bus lookup)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Places API (optional, for venue ratings / review enrichment)
GOOGLE_MAPS_API_KEY=
