# 後端單一容器：包含 ADK Agent (port 8001) + API Proxy (port 8000)
# 由 repo root 建置（docker-compose 會自動處理 context），以便同時複製
# adk_agent、recommender、shared 以及 exhibitions.json。

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 先複製 requirements 以利用 Docker layer cache
COPY backend/adk_agent/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# 複製後端程式碼與資料
COPY backend /app/backend
COPY data /app/data
COPY exhibitions.json /app/exhibitions.json

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ADK_PORT=8001

WORKDIR /app/backend/adk_agent

EXPOSE 8000 8001

# 先啟動 ADK Web，確認本機 8001 可連後再啟動公開的 FastAPI proxy。
# 這能避免 Cloud Run 已 ready、但 /api/run 還連不到 ADK 的競態。
CMD ["bash", "-c", "set -e; echo 'Starting ADK web on 8001'; adk web --host 0.0.0.0 --port 8001 --allow_origins '*' 2>&1 & ADK_PID=$!; for i in $(seq 1 60); do if ! kill -0 \"$ADK_PID\" 2>/dev/null; then echo 'ADK web exited during startup'; wait \"$ADK_PID\"; exit 1; fi; if curl -fsS http://127.0.0.1:8001/docs >/dev/null; then echo 'ADK web is ready'; break; fi; sleep 1; if [ \"$i\" = '60' ]; then echo 'Timed out waiting for ADK web'; exit 1; fi; done; exec uvicorn api_proxy_server:app --host 0.0.0.0 --port 8000"]
