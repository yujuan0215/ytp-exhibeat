# 後端單一容器：包含 ADK Agent (port 8001) + API Proxy (port 8000)
# 由 repo root 建置（docker-compose 會自動處理 context），以便同時複製
# adk_agent、recommender、shared 以及 exhibitions.json。

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 先複製 requirements 以利用 Docker layer cache
COPY backend/adk_agent/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# 複製後端程式碼與資料
COPY backend /app/backend
COPY exhibitions.json /app/exhibitions.json

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    ADK_PORT=8001

WORKDIR /app/backend/adk_agent

EXPOSE 8000 8001

# 用一行 bash 同時啟動 adk web 與 uvicorn（容器被停掉時兩者會一起退出）
CMD ["bash", "-c", "adk web --host 0.0.0.0 --port 8001 --allow_origins '*' & uvicorn api_proxy_server:app --host 0.0.0.0 --port 8000"]
