# Google Maps JavaScript API, used only by the frontend map page.
# Enable: https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key

# Optional: Google Cloud map styling.
VITE_GOOGLE_MAP_ID=

# Optional: "cloud" uses VITE_GOOGLE_MAP_ID, "local" uses styles in code.
VITE_GOOGLE_MAP_STYLE_MODE=cloud
